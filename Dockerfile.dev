FROM node:22.17.0-bookworm-slim

WORKDIR /app

# Dependencies are locked in package-lock.json and installed at image build
# time, so starting the local service never needs to fetch packages.
COPY package.json package-lock.json ./
RUN npm ci

COPY . ./
RUN mkdir -p /state && chown -R node:node /app /state

USER node

# Prevent Wrangler from discovering an accidental .env/.dev.vars file. The
# local-only token is deliberately defined in wrangler.dev.jsonc instead.
ENV CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false

EXPOSE 8788
VOLUME ["/state"]

CMD ["sh", "-c", "npm exec -- wrangler d1 migrations apply TRACKER_DB --config wrangler.dev.jsonc --local --persist-to /state && exec npm exec -- wrangler dev --config wrangler.dev.jsonc --local --persist-to /state --ip 0.0.0.0 --port 8788"]
