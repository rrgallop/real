{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ryan-gallop-real-estate",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["LINK_TRACKER_ADMIN_TOKEN"]
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "homes.ryangallop.com",
      "custom_domain": true
    },
    {
      "pattern": "ryangallop.com",
      "custom_domain": true
    },
    {
      "pattern": "www.ryangallop.com",
      "custom_domain": true
    },
    {
      "pattern": "rgallop.com",
      "custom_domain": true
    },
    {
      "pattern": "www.rgallop.com",
      "custom_domain": true
    },
    {
      "pattern": "www.reinventingrealty.co",
      "custom_domain": true
    },
    {
      "pattern": "reinventingrealty.co/*",
      "zone_name": "reinventingrealty.co"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "TRACKER_DB",
      "database_name": "ryan-gallop-link-tracker",
      "database_id": "ebe37ec8-e963-4c6e-8b36-894b2c92e81d",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      // Invocation logs include the full request URL. Disable them so tracking
      // tokens are not retained; token-free structured console errors remain.
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      // Automatic fetch traces include url.full, url.path, and raw user-agent
      // metadata. Keep them off so opaque tracking tokens are not retained by
      // platform observability.
      "enabled": false
    }
  }
}
